layout {

    focus-ring {
        active-color   "#f5bb84"
        inactive-color "#17130f"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f5bb84"
        inactive-color "#17130f"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#f5bb84"
        inactive-color "#5c360a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f5bb8480"
    }
}

recent-windows {
    highlight {
        active-color "#f5bb84"
        urgent-color "#ffb4ab"
    }
}
