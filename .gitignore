.backups/

# Copies de securite locales : utiles sur le systeme, inutiles dans git.
# (rsync les recopie quand meme dans le depot, git les ignore simplement)
*.bak
*.pre-papercolor

# ~/.local/share/icons : symlinks vers le theme (Gruvbox, clone via clones.list)
# + icones/cache generes par les applis. Plus gere par update.sh -> ignore.
/.local/
*.bak.*
*.bak-*

# Ancien format noctalia (< v5) : plus gere, la config v5 est dans hosts/<machine>/.local/state/noctalia/
.config/noctalia/

# Variables universelles fish : etat propre a chaque machine (chemins, fisher), regenere par fish.
.config/fish/fish_variables

# Couleurs niri generees par noctalia depuis le fond d ecran : propre a chaque machine.
.config/niri/noctalia.kdl

# Generes par les templates noctalia (regeneres avec : noctalia msg templates-apply)
.config/gtk-3.0/noctalia.css
.config/gtk-4.0/noctalia.css
.config/kitty/themes/
# Signets Nautilus : montages propres a chaque machine
.config/gtk-3.0/bookmarks
# Ancien theme kitty fige (PaperColor), remplace par le template noctalia
.config/kitty/current-theme.conf
