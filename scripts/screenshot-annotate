#!/bin/sh
# screenshot-annotate — selectionne une zone, annote avec satty, puis enregistre.
#
# Chaine : slurp (selection) -> grim (capture) -> satty (annotation/sauvegarde).
# Wayland natif via le protocole wlroots : pas de portail XDG requis.
# Appele depuis niri (bind Print).

set -eu

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"

# slurp renvoie la zone ; une selection annulee (Echap) sort sans erreur.
geometry=$(slurp) || exit 0

grim -g "$geometry" - | satty \
    --filename - \
    --output-filename "$DIR/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png" \
    --early-exit \
    --copy-command wl-copy
